generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// *
///  * Represents a tenant (merchant/organization) boundary.
///  *
///  * Notes:
///  * - Most tenant-scoped tables reference `tenantId`.
///  * - This model itself is platform-scoped (not filtered by tenant RLS).
model Tenant {
  id          String             @id
  name        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  products    Product[]
  memberships TenantMembership[]
}

/// *
///  * Represents an authenticated principal.
///  *
///  * Notes:
///  * - This is identity-level, not tenancy-level.
///  * - Tenancy linkage is represented via `TenantMembership`.
model User {
  id          String             @id
  email       String             @unique
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships TenantMembership[]
}

/// *
///  * Links a user to a tenant.
///  *
///  * Notes:
///  * - `roleKey` is intentionally a simple string placeholder until Phase 3 IAM.
///  * - RLS should enforce that tenant-scoped access is filtered by tenant context.
model TenantMembership {
  tenantId  String
  userId    String
  /// *
  ///    * Placeholder role key (non-authoritative until IAM).
  ///    *
  ///    * Examples: "TENANT_ADMIN", "SALES"
  roleKey   String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

/// *
///  * Represents a product within a tenant's catalog.
///  *
///  * Notes:
///  * - `status` uses string codes (not DB enums) per blueprint requirements
///  * - `slug` is unique per tenant for URL-friendly identifiers
///  * - `publishedAt` tracks when product became visible
model Product {
  id             String                 @id
  tenantId       String
  /// *
  ///    * Product state: "draft", "published", or "inactive"
  ///    *
  ///    * Notes:
  ///    * - String-based codes allow flexibility vs DB enums
  ///    * - Will have FK to product_status lookup table (DB-24)
  status         String                 @default("draft")
  /// *
  ///    * URL-friendly identifier for the product.
  ///    *
  ///    * Notes:
  ///    * - Unique per tenant for SEO-friendly URLs
  ///    * - Must match ProductSlug contract validation
  slug           String
  /// *
  ///     * Product display name.
  name           String
  description    String?
  /// *
  ///    * Timestamp when product was first published.
  ///    *
  ///    * Notes:
  ///    * - Null for draft/inactive products
  ///    * - Set on first transition to published
  publishedAt    DateTime?
  /// *
  ///    * Standard audit timestamps.
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  statusRelation ProductStatus          @relation(fields: [status], references: [code])
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statusHistory  ProductStatusHistory[]
  taxonomy       ProductTaxonomy[]
  variants       Variant[]

  @@index([tenantId, status])
  @@index([tenantId, slug])
  @@index([tenantId, publishedAt])
}

/// *
///  * Represents a product variant (SKU, pricing, inventory).
///  *
///  * Notes:
///  * - SKU is unique per tenant
///  * - Attributes stored as JSON for flexibility
model Variant {
  id          String   @id
  productId   String
  tenantId    String
  /// *
  ///    * Stock Keeping Unit - unique identifier for the variant.
  ///    *
  ///    * Notes:
  ///    * - Unique per tenant for inventory tracking
  ///    * - Human-readable vs internal ID
  sku         String
  /// *
  ///    * Variant display name.
  name        String
  /// *
  ///    * Detailed variant description.
  description String?
  /// *
  ///    * Variant-defining attributes (color, size, etc.).
  ///    *
  ///    * Notes:
  ///    * - JSON for schema flexibility
  ///    * - Should align with Variant attributes contract
  attributes  Json?
  /// *
  ///    * Standard audit timestamps.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, sku])
  @@index([productId])
}

/// *
///  * Represents taxonomy nodes for product classification.
///  *
///  * Notes:
///  * - Hierarchical structure via self-referencing parent
///  * - Platform-owned but tenant-participated
///  * - Descriptive-only, not authoritative for product identity
model Taxonomy {
  id        String            @id
  /// *
  ///    * Parent node for hierarchical structure.
  ///    *
  ///    * Notes:
  ///    * - Null for root nodes
  ///    * - Enforces acyclic tree structure
  parentId  String?
  /// *
  ///    * Display label for the taxonomy node.
  label     String
  /// *
  ///    * Ordering among siblings.
  sortOrder Int?
  /// *
  ///    * Metadata for taxonomy node (config, rules, etc.).
  metadata  Json?
  /// *
  ///    * Standard audit timestamps.
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductTaxonomy[]
  parent    Taxonomy?         @relation("TaxonomyHierarchy", fields: [parentId], references: [id])
  children  Taxonomy[]        @relation("TaxonomyHierarchy")

  @@index([parentId])
  @@index([sortOrder])
}

/// *
///  * Join table for product-taxonmy classification.
///  *
///  * Notes:
///    * Enables many-to-many product-category relationships
///  * - Enforces tenant-scoped classification
///  * - Tracks when product was classified
model ProductTaxonomy {
  productId  String
  taxonomyId String
  tenantId   String
  /// *
  ///    * When this classification was created.
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxonomy   Taxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade)

  @@id([productId, taxonomyId])
  @@index([tenantId, productId])
  @@index([tenantId, taxonomyId])
}

/// *
///  * Lookup table for product status codes.
///  *
///  * Notes:
///  * - String-based status codes per blueprint
///  * - Supports governance without DB enums
///  * - Platform-owned, tenant-used
model ProductStatus {
  code        String    @id
  /// *
  ///    * Human-readable status label.
  label       String
  /// *
  ///    * Description of status behavior.
  description String?
  /// *
  ///    * Whether products with this status are publicly visible.
  isPublic    Boolean   @default(false)
  /// *
  ///    * Whether products with this status can be ordered.
  isOrderable Boolean   @default(false)
  /// *
  ///    * Display order in UI.
  sortOrder   Int?
  /// *
  ///    * Standard audit timestamps.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

/// *
///  * Audit trail for product-taxonmy assignments.
///  *
///  * Notes:
///  * - Tracks when products are classified/unclassified
///  * - Supports governance and analytics
///  * - Tenant-scoped for isolation
model ProductTaxonomyHistory {
  id         String   @id
  productId  String
  taxonomyId String
  tenantId   String
  /// *
  ///    * Action type: assign or unassign.
  action     String
  /// *
  ///    * Who made the change.
  changedBy  String?
  /// *
  ///    * Actor type.
  actorType  String   @default("user")
  /// *
  ///    * Reason for the change.
  reason     String?
  /// *
  ///    * When the change occurred.
  changedAt  DateTime @default(now())

  @@index([tenantId, productId])
  @@index([tenantId, taxonomyId])
  @@index([tenantId, changedAt])
}

/// *
///  * Audit trail for product publication status changes.
///  *
///  * Notes:
///  * - Tracks all status transitions
///  * - Enables audit and rollback capabilities
///  * - Tenant-scoped for isolation
model ProductStatusHistory {
  id             String   @id
  productId      String
  tenantId       String
  /// *
  ///    * Previous status (null for initial creation).
  previousStatus String?
  /// *
  ///    * New status after transition.
  newStatus      String
  /// *
  ///    * Who made the change (user ID or system).
  changedBy      String?
  /// *
  ///    * Actor type: user, system, migration, etc.
  actorType      String   @default("user")
  /// *
  ///    * Reason for the status change.
  reason         String?
  /// *
  ///    * When the change occurred.
  changedAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@index([tenantId, changedAt])
}

/// *
///  * Represents a global principal (who).
///  *
///  * Notes:
///  * - Scope-agnostic by design
///  * - Never contains tenant-specific information
///  * - Email must be globally unique where applicable
model Identity {
  id                  String              @id
  email               String              @unique
  lifecycleStatusCode String              @default("active")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  passwordCredentials PasswordCredential[]
  accounts            Account[]
  sessions            Session[]
}

/// *
///  * Represents scope-bound participation (where/how).
///  *
///  * Notes:
///  * - Links identity to specific execution context
///  * - Tenant-scoped accounts require tenantId
///  * - Platform-scoped accounts forbid tenantId
model Account {
  id                String       @id
  identityId        String
  scopeCode         String
  tenantId          String?
  accountStatusCode String       @default("active")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  identity          Identity     @relation(fields: [identityId], references: [id])
  accountRoles      AccountRole[]
  sessions          Session[]
}

/// *
///  * Stores password authentication credentials.
///  *
///  * Notes:
///  * - One-to-one with identity
///  * - Never stores plain text passwords
///  * - Includes algorithm metadata for verification
model PasswordCredential {
  identityId      String    @id
  passwordHash    String
  algorithm       String
  algorithmParams Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  identity        Identity  @relation(fields: [identityId], references: [id])
}

/// *
///  * Represents active authentication context.
///  *
///  * Notes:
///  * - Links identity, account, scope, and tenant
///  * - Has explicit expiration for security
///  * - Can be revoked administratively
model Session {
  id                String     @id
  identityId        String
  accountId         String
  scopeCode         String
  tenantId          String?
  createdAt         DateTime   @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReasonCode String?
  identity          Identity   @relation(fields: [identityId], references: [id])
  account           Account    @relation(fields: [accountId], references: [id])
}

/// *
///  * Represents a role within the authorization system.
///  *
///  * Notes:
///  * - Scope-bound to prevent cross-scope assignment
///  * - Human-readable for management interfaces
///  * - Stable codes for referential integrity
model Role {
  code          String            @id
  scopeCode     String
  name          String
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  accountRoles  AccountRole[]
  rolePermissions RolePermission[]
}

/// *
///  * Represents a granular permission.
///  *
///  * Notes:
///  * - Scope-bound to prevent cross-scope assignment
///  * - Action:resource format for clarity
///  * - Descriptive for audit and management
model Permission {
  code            String            @id
  scopeCode       String
  action          String
  description     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rolePermissions RolePermission[]
}

/// *
///  * Links account to role within scope.
///  *
///  * Notes:
///  * - Prevents cross-scope role assignment
///  * - Tracks assignment metadata for audit
///  * - Supports multiple roles per account
model AccountRole {
  id          String     @id
  accountId   String
  roleCode    String
  assignedAt  DateTime   @default(now())
  assignedBy  String
  reason      String?
  account     Account    @relation(fields: [accountId], references: [id])
  role        Role       @relation(fields: [roleCode], references: [code])

  @@unique([accountId, roleCode])
}

/// *
///  * Links role to permission.
///  *
///  * Notes:
///  * - Prevents cross-scope permission grants
///  * - Tracks grant metadata for audit
///  * - Supports many-to-many relationships
model RolePermission {
  id            String     @id
  roleCode      String
  permissionCode String
  grantedAt     DateTime   @default(now())
  reason        String?
  role          Role       @relation(fields: [roleCode], references: [code])
  permission    Permission @relation(fields: [permissionCode], references: [code])

  @@unique([roleCode, permissionCode])
}

/// *
///  * Records authentication events for audit trail.
///  *
///  * Notes:
///  * - Append-only audit log for security compliance
///  * - Tracks success/failure events for analysis
///  * - Supports forensic investigation
///  * - Platform-scoped (no tenant filtering for audit visibility)
model AuthEvent {
  id           String   @id @default(cuid())
  identityId   String?
  accountId    String?
  eventType    String
  scope        String?
  tenantId     String?
  sessionId    String?
  failureReason String?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())
  success      Boolean

  @@map("auth_events")
  @@index([identityId])
  @@index([timestamp])
  @@index([eventType])
}

/// *
///  * Represents a tenant's inventory for a specific catalog variant.
///  *
///  * Notes:
///  * - Uses loose coupling with catalog via catalog_variant_id (no FK)
///  * - Enforces tenant isolation via tenant_id and RLS policies
///  * - Maintains quantity invariants with check constraints (added via migration)
///  *
model InventoryItem {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  catalogVariantId  String    @map("catalog_variant_id")
  onHandQuantity    Int       @map("on_hand_quantity") @default(0)
  reservedQuantity  Int       @map("reserved_quantity") @default(0)
  allocatedQuantity Int       @map("allocated_quantity") @default(0)
  isActive          Boolean   @map("is_active") @default(true)
  isSellable        Boolean   @map("is_sellable") @default(false)
  lowStockThreshold Int?      @map("low_stock_threshold")
  location          Json?
  source            String?
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(10, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  stockMovements    StockMovement[]
  reservations       InventoryReservation[]
  allocations        InventoryAllocation[]
  auditEvents        InventoryAuditEvent[]

  @@unique([tenantId, catalogVariantId])
  @@index([tenantId])
  @@index([catalogVariantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isSellable])
  @@map("inventory_items")
}

/// *
///  * Represents a temporary claim against available inventory.
///  *
///  * Notes:
///  * - Reduces available quantity but not on-hand quantity
///  * - Has finite lifetime and can be released or converted
///  * - Used for cart reservations, order holds, manual holds
///  *
model InventoryReservation {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  inventoryId String    @map("inventory_id")
  quantity    Int
  purpose     String
  status      String    @default("active")
  expiresAt   DateTime? @map("expires_at")
  releasedAt  DateTime? @map("released_at")
  referenceId String?   @map("reference_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  inventory   InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, inventoryId])
  @@index([expiresAt])
  @@index([status])
  @@index([tenantId, purpose])
  @@index([tenantId, status, expiresAt])
  @@map("inventory_reservations")
}

/// *
///  * Represents a committed assignment of inventory to fulfillment.
///  *
///  * Notes:
///  * - Durable and not reversible without compensating action
///  * - Reduces available quantity permanently
///  * - Used for order fulfillment, shipping allocations
///  *
model InventoryAllocation {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  inventoryId String    @map("inventory_id")
  quantity    Int
  purpose     String
  referenceId String    @map("reference_id")
  reversedAt  DateTime? @map("reversed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  inventory   InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, inventoryId, referenceId])
  @@index([tenantId, inventoryId])
  @@index([referenceId])
  @@index([tenantId, purpose])
  @@map("inventory_allocations")
}

/// *
///  * Represents any change to on-hand inventory quantity.
///  *
///  * Notes:
///  * - Tracks increases, decreases, and adjustments
///  * - Used for audit trail and reconciliation
///  * - Maintains complete change history
///  *
model StockMovement {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  inventoryId String    @map("inventory_id")
  movementType String   @map("movement_type")
  quantity    Int
  reason      String
  referenceId String?   @map("reference_id")
  initiatedBy String    @map("initiated_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  inventory   InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, inventoryId])
  @@index([createdAt])
  @@index([movementType])
  @@index([referenceId])
  @@map("stock_movements")
}

/// *
///  * Represents an audit event for inventory operations.
///  *
///  * Notes:
///  * - Every mutation produces an audit record
///  * - Stores before/after state snapshots
///  * - Provides complete audit trail
///  *
model InventoryAuditEvent {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  inventoryId String    @map("inventory_id")
  eventType   String    @map("event_type")
  beforeState Json?     @map("before_state")
  afterState  Json?     @map("after_state")
  reason      String
  initiatedBy String    @map("initiated_by")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  inventory   InventoryItem @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId, inventoryId])
  @@index([createdAt])
  @@index([eventType])
  @@index([initiatedBy])
  @@map("inventory_audit_events")
}


/// *
///  * Lookup table for cart status codes.
///  *
///  * Notes:
///  * - String-based status codes per blueprint requirements
///  * - Supports governance without DB enums
///  * - Platform-owned, tenant-used
///  * - Includes business logic flags for second line of defense
model CartStatus {
  code        String    @id
  /// *
  ///    * Human-readable status label.
  label       String
  /// *
  ///    * Description of status behavior.
  description String?
  /// *
  ///    * Whether carts with this status can be modified.
  ///    * Acts as DB-level validation for TypeScript domain logic.
  isModifiable Boolean   @default(true)
  /// *
  ///    * Whether carts with this status can be converted to orders.
  ///    * Prevents conversion of abandoned or expired carts.
  isConvertible Boolean   @default(false)
  /// *
  ///    * Whether this status represents a deleted cart.
  ///    * Used for soft-delete filtering and analytics.
  isDeleted    Boolean   @default(false)
  /// *
  ///    * Display order in UI.
  sortOrder   Int?
  /// *
  ///    * Standard audit timestamps.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  carts       Cart[]
}

/// *
///  * Lookup table for order status codes.
///  *
///  * Notes:
///  * - String-based status codes per blueprint requirements
///  * - Supports governance without DB enums
///  * - Platform-owned, tenant-used
///  * - Includes business logic flags for second line of defense
model OrderStatus {
  code        String    @id
  /// *
  ///    * Human-readable status label.
  label       String
  /// *
  ///    * Description of status behavior.
  description String?
  /// *
  ///    * Whether orders with this status can be modified.
  ///    * Acts as DB-level validation for TypeScript domain logic.
  isModifiable Boolean   @default(true)
  /// *
  ///    * Whether orders with this status are terminal (no further transitions).
  ///    * Critical for state machine enforcement at DB level.
  isTerminal   Boolean   @default(false)
  /// *
  ///    * Whether this status allows customer address updates.
  ///    * Fine-grained control for customer self-service.
  allowsAddressUpdates Boolean @default(false)
  /// *
  ///    * Display order in UI.
  sortOrder   Int?
  /// *
  ///    * Standard audit timestamps.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      Order[]
}

/// *
///  * Represents a customer's shopping cart within a tenant.
///  *
///  * Notes:
///  * - Customer-owned, tenant-responsible for multi-tenant integrity
///  * - Uses ULID for distributed system compatibility and sortability
///  * - One cart per customer per tenant enforced by unique constraint
///  * - Includes price freshness tracking for Ethiopian market volatility
///  * - Soft-delete via status rather than physical deletion for analytics
model Cart {
  id                String    @id
  customerId        String    @map("customer_id")
  tenantId          String    @map("tenant_id")
  status            String    @default("active")
  currency          String    @default("ETB") // Ethiopia context
  expiresAt         DateTime? @map("expires_at")
  /// *
  ///    * Cart subtotal for quick queries and reporting.
  ///    * Calculated and maintained at application level.
  ///    * String-based decimal prevents floating-point errors.
  subtotalAmount    String?   @map("subtotal_amount")
  /// *
  ///    * Total number of items in cart (sum of quantities).
  ///    * Denormalized for cart list performance.
  totalItems        Int?      @map("total_items") @default(0)
  /// *
  ///    * Metadata for promotions, discounts, or campaign tracking.
  ///    * JSONB for flexible schema evolution.
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  statusRelation    CartStatus         @relation(fields: [status], references: [code])
  items             CartItem[]
  statusHistory     CartStatusHistory[]

  @@unique([customerId, tenantId]) // One cart per customer per tenant
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([expiresAt]) // For cart cleanup jobs
  @@index([createdAt]) // For analytics
  @@index([status, expiresAt]) // For abandoned cart detection
  @@map("carts")
}

/// *
///  * Represents items within a customer's cart.
///  *
///  * Notes:
///  * - Tracks observed unit price and capture timestamp for freshness validation
///  * - Supports price freshness validation for Ethiopian market
///  * - Links to catalog variant via loose coupling (no FK dependency)
///  * - Uses ULID for distributed system compatibility
///  * - Denormalized customerId for RLS performance optimization
model CartItem {
  id                String    @id
  cartId            String    @map("cart_id")
  customerId        String    @map("customer_id") // Denormalized for RLS performance
  tenantId          String    @map("tenant_id")
  catalogVariantId  String    @map("catalog_variant_id")
  quantity          Int
  /// *
  ///    * Observed unit price at time of adding to cart.
  ///    * String-based decimal prevents floating-point errors.
  ///    * Critical for price freshness validation.
  observedUnitPrice String    @map("observed_unit_price")
  /// *
  ///    * Line item total (quantity * observedUnitPrice).
  ///    * Denormalized for cart calculation performance.
  lineTotal         String    @map("line_total")
  /// *
  ///    * Product name snapshot at time of adding to cart.
  ///    * Preserves accuracy even if product is later renamed.
  productName       String    @map("product_name")
  /// *
  ///    * Variant name snapshot at time of adding to cart.
  ///    * Preserves accuracy for order history.
  variantName       String    @map("variant_name")
  /// *
  ///    * When the price was captured for freshness validation.
  ///    * Essential for Ethiopian market price volatility checks.
  priceCapturedAt   DateTime  @map("price_captured_at")
  /// *
  ///    * Metadata for promotions, discounts, or variant attributes.
  ///    * JSONB for flexible schema evolution.
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  cart              Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, catalogVariantId]) // One item per product per cart
  @@index([tenantId, catalogVariantId]) // For inventory lookups
  @@index([cartId]) // For cart item queries
  @@index([customerId]) // For customer cart queries (RLS optimization)
  @@index([priceCapturedAt]) // For price freshness validation
  @@map("cart_items")
}

/// *
///  * Represents a customer's order within a tenant.
///  *
///  * Notes:
///  * - Customer-owned, tenant-responsible for multi-tenant integrity
///  * - Immutable pricing snapshots for order integrity and compliance
///  * - Links to inventory reservations for stock control and audit
///  * - Ethiopia-specific address fields (subCity, woreda) in JSON structure
///  * - Comprehensive financial breakdown for reporting and analytics
model Order {
  id                String    @id
  customerId        String    @map("customer_id")
  tenantId          String    @map("tenant_id")
  status            String    @default("pending")
  currency          String    @default("ETB") // Ethiopia context
  /// *
  ///    * Order subtotal (sum of all item line totals).
  ///    * Immutable snapshot at order creation.
  ///    * String-based decimal prevents floating-point errors.
  subtotalAmount    String    @map("subtotal_amount")
  /// *
  ///    * Tax amount calculated at order creation.
  ///    * Immutable for financial compliance.
  taxAmount         String    @map("tax_amount")
  /// *
  ///    * Shipping costs calculated at order creation.
  ///    * Immutable for financial compliance.
  shippingAmount    String    @map("shipping_amount")
  /// *
  ///    * Total order amount (subtotal + tax + shipping).
  ///    * Immutable for financial compliance and audit.
  totalAmount       String    @map("total_amount")
  /// *
  ///    * Shipping address with Ethiopia-specific fields.
  ///    * JSONB structure: {street, city, state, subCity?, woreda?, postalCode?, country}
  ///    * Strictly validated at application layer before DB insertion.
  shippingAddress   Json      @map("shipping_address")
  /// *
  ///    * Billing address with Ethiopia-specific fields.
  ///    * JSONB structure: {street, city, state, subCity?, woreda?, postalCode?, country}
  ///    * Strictly validated at application layer before DB insertion.
  billingAddress    Json      @map("billing_address")
  /// *
  ///    * Number of items in the order (sum of quantities).
  ///    * Denormalized for order list performance.
  totalItems        Int       @map("total_items") @default(0)
  /// *
  ///    * When the order is expected to be shipped.
  ///    * Set by tenant staff during order processing.
  estimatedShipAt   DateTime? @map("estimated_ship_at")
  /// *
  ///    * When the order was actually shipped.
  ///    * Set by system or tenant staff during fulfillment.
  shippedAt         DateTime? @map("shipped_at")
  /// *
  ///    * When the order was delivered.
  ///    * Set by system or tenant staff during fulfillment.
  deliveredAt       DateTime? @map("delivered_at")
  /// *
  ///    * Metadata for promotions, discounts, or tracking information.
  ///    * JSONB for flexible schema evolution.
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  statusRelation    OrderStatus         @relation(fields: [status], references: [code])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]

  @@index([tenantId, status]) // For tenant order management
  @@index([tenantId, customerId]) // For customer order lookup
  @@index([customerId]) // For customer order history
  @@index([createdAt]) // For analytics and reporting
  @@index([status]) // For order processing queues
  @@index([estimatedShipAt]) // For shipping queue
  @@index([shippedAt]) // For delivery tracking
  @@map("orders")
}

/// *
///  * Represents items within an order.
///  *
///  * Notes:
///  * - Immutable pricing snapshot captured at order creation
///  * - Links to inventory reservation for stock tracking and audit
///  * - Includes comprehensive metadata for compliance and analytics
///  * - Uses ULID for distributed system compatibility
///  * - Denormalized customerId for RLS performance optimization
model OrderItem {
  id                    String    @id
  orderId               String    @map("order_id")
  customerId            String    @map("customer_id") // Denormalized for RLS performance
  tenantId              String    @map("tenant_id")
  catalogVariantId      String    @map("catalog_variant_id")
  /// *
  ///    * Link to inventory reservation for stock tracking.
  ///    * Critical for Phase 4 integration and audit trail.
  ///    * Nullable for orders created before reservation system.
  inventoryReservationId String?  @map("inventory_reservation_id")
  quantity              Int
  /// *
  ///    * Immutable unit price snapshot at order creation.
  ///    * String-based decimal prevents floating-point errors.
  ///    * Preserves pricing integrity for financial compliance.
  unitPrice             String    @map("unit_price")
  /// *
  ///    * Immutable line total (quantity * unitPrice).
  ///    * String-based decimal prevents floating-point errors.
  ///    * Matches Order.totalAmount calculation.
  totalPrice            String    @map("total_price")
  /// *
  ///    * Product name snapshot at order creation.
  ///    * Preserves accuracy even if product is later renamed.
  ///    * Critical for order history and customer receipts.
  productName           String    @map("product_name")
  /// *
  ///    * Variant name snapshot at order creation.
  ///    * Preserves accuracy for order history and customer service.
  variantName           String    @map("variant_name")
  /// *
  ///    * Variant attributes snapshot (color, size, etc.).
  ///    * JSONB for flexible schema while preserving order accuracy.
  variantAttributes     Json?     @map("variant_attributes")
  /// *
  ///    * Pricing metadata for audit and compliance.
  ///    * Includes priceCapturedAt, originalCartItemId, tax breakdowns.
  ///    * JSONB for comprehensive audit trail.
  pricingMetadata       Json?     @map("pricing_metadata")
  createdAt             DateTime  @default(now()) @map("created_at")

  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, catalogVariantId]) // For catalog analytics
  @@index([orderId]) // For order item queries
  @@index([inventoryReservationId]) // For inventory tracking
  @@index([customerId]) // For customer order queries (RLS optimization)
  @@map("order_items")
}

/// *
///  * Audit trail for cart status changes.
///  *
///  * Notes:
///  * - Tracks all status transitions for audit compliance
///  * - Enables rollback capabilities and analytics
///  * - Customer-scoped for isolation and privacy
///  * - Preserved even if cart is soft-deleted for compliance
model CartStatusHistory {
  id             String   @id
  cartId         String   @map("cart_id")
  tenantId       String   @map("tenant_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  changedBy      String?  @map("changed_by")
  actorType      String   @default("user") @map("actor_type")
  reason         String?
  changedAt      DateTime @default(now()) @map("changed_at")

  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([tenantId, cartId]) // For cart history queries
  @@index([tenantId, changedAt]) // For tenant analytics
  @@index([cartId, changedAt]) // For cart timeline
  @@map("cart_status_history")
}

/// *
///  * Audit trail for order status changes.
///  *
///  * Notes:
///  * - Tracks all status transitions for audit compliance
///  * - Enables rollback capabilities and analytics
///  * - Customer-scoped for isolation and privacy
///  * - Critical for dispute resolution and financial compliance
model OrderStatusHistory {
  id             String   @id
  orderId        String   @map("order_id")
  tenantId       String   @map("tenant_id")
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  changedBy      String?  @map("changed_by")
  actorType      String   @default("user") @map("actor_type")
  reason         String?
  changedAt      DateTime @default(now()) @map("changed_at")

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId]) // For order history queries
  @@index([tenantId, changedAt]) // For tenant analytics
  @@index([orderId, changedAt]) // For order timeline
  @@map("order_status_history")
}
